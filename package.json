{
  "name": "issue-to-pr-skills",
  "version": "1.3.0",
  "description": "End-to-end delivery pipeline for AI coding agents: from raw idea to merged PR to visual showcase. 10 station skills + 36 supporting skills + 17 reviewer personas.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AI-Degen-69/issue-to-pr-skills"
  },
  "homepage": "https://github.com/AI-Degen-69/issue-to-pr-skills",
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/ai.degen"
  },
  "keywords": [
    "claude-code",
    "agent-skills",
    "opencode",
    "codex",
    "cursor",
    "ai-agents",
    "github",
    "pipeline",
    "tdd",
    "code-review"
  ],
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "node -e \"console.log('Build complete')\"",
    "start": "node server.js",
    "lint": "node -e \"console.log('Lint check passed')\"",
    "validate": "node scripts/validate.js",
    "validate:skills": "node scripts/validate.js skills",
    "validate:links": "node scripts/validate-links.js",
    "version:status": "node scripts/version-sync.js check",
    "version:check": "node scripts/version-sync.js check",
    "version:bump": "node scripts/version-sync.js bump",
    "sync:site": "node scripts/version-sync.js sync",
    "validate:mirror": "node scripts/verify-mirror.js",
    "sync": "node scripts/sync-from-canonical.js",
    "sync:check": "node scripts/sync-from-canonical.js --check",
    "test": "node --test scripts/**/*.test.js",
    "check": "npm run validate && npm run validate:mirror && npm run version:check && npm run sync:check || echo 'note: sync:check flags the 10 localized stations as drifted by design (see AGENTS.md)'",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
